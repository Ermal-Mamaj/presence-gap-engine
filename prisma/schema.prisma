// Presence Gap Engine — data model
//
// Campaign  = one "target box" (region + niche + weakness focus)
// Business  = a lead pulled from a source (OSM / Google Maps scraper)
// GapSignal = one publicly-observable weakness detected for a Business
// Outreach  = a drafted message for a Business, tied to a CRM stage
// ScanRun   = one execution of a Campaign's discovery; Businesses outlive scans
// StageChange = append-only CRM history for a Business

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum SourceType {
  OSM
  GOOGLE_MAPS_SCRAPER
}

enum CampaignStatus {
  DRAFT
  RUNNING
  DONE
  FAILED
}

enum ScanStatus {
  RUNNING
  SUCCEEDED
  FAILED
}

// What the website check concluded. NEEDS_CHECK means the evidence is
// incomplete or inconclusive (e.g. one failed request), not "bad".
enum WebsiteStatus {
  NONE_FOUND
  NEEDS_WORK
  NEEDS_CHECK
  GOOD
}

enum CrmStage {
  NEW
  QUALIFIED
  CONTACTED
  REPLIED
  CONVERTED
  DELIVERED
  RETAINED
  DEAD
}

model Campaign {
  id          String         @id @default(cuid())
  name        String
  region      String
  niche       String
  source      SourceType     @default(OSM)
  language    String         @default("en") // drafts are written in this; see src/lib/outreachOptions.ts
  status      CampaignStatus @default(DRAFT)
  errorMessage String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  businesses  Business[]
  scans       ScanRun[]
}

model ScanRun {
  id           String     @id @default(cuid())
  campaignId   String
  campaign     Campaign   @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  status       ScanStatus @default(RUNNING)
  errorMessage String?
  found        Int        @default(0) // valid, de-duplicated records the source returned
  created      Int        @default(0) // new leads added by this scan
  updated      Int        @default(0) // existing leads refreshed by this scan
  skipped      Int        @default(0) // invalid or duplicate records ignored
  deferred     Int        @default(0) // websites over the per-scan check limit, left for the next scan

  startedAt    DateTime   @default(now())
  finishedAt   DateTime?

  @@index([campaignId, startedAt])
}

model Business {
  id            String   @id @default(cuid())
  campaignId    String
  campaign      Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  name          String
  address       String?
  phone         String?
  email         String?  // from the listing, else the first mailto: link on the business's own site
  emailFromSite Boolean  @default(false) // true when email came from the site, which may be a web agency's credit
  facebook      String?  // profile URL
  instagram     String?  // profile URL
  website       String?
  latitude      Float?
  longitude     Float?
  rating        Float?
  reviewCount   Int?
  sourceRef     String?  // id/url from the originating source, for provenance
  dedupeKey     String   // stable identity within a campaign, see src/lib/dedupe.ts
  websiteStatus WebsiteStatus @default(NEEDS_CHECK)
  siteCheckedAt DateTime? // when a scan last fetched the current website; null = not yet
  lastSeenAt    DateTime @default(now()) // last scan that returned this business

  score         Float    @default(0)
  crmStage      CrmStage @default(NEW)
  notes         String?
  followUpAt    DateTime? // the day to get back to this lead; null = nothing scheduled

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  signals       GapSignal[]
  outreach      Outreach[]
  stageChanges  StageChange[]

  @@unique([campaignId, dedupeKey])
  @@index([campaignId])
  @@index([campaignId, score])
  @@index([followUpAt])
}

model GapSignal {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  key        String   // e.g. "no_website", "not_https", "no_mobile_viewport", "site_unreachable", "stale_site"
  label      String   // human-readable, e.g. "No website found"
  severity   Int      // contribution to score, higher = stronger gap
  detail     String?  // freeform evidence, e.g. status code, response time
  certainty  String   @default("VERIFIED") // UNCERTAIN when a single failed check can't prove it

  createdAt  DateTime @default(now())

  @@index([businessId])
}

model Outreach {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  channel    String   @default("email")
  subject    String?
  body       String
  openLine   String
  sentAt     DateTime? // when this draft was actually sent; null = not sent
  // The template it was filled from; null for an AI draft or a deleted template.
  templateId String?
  template   MessageTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  createdAt  DateTime @default(now())

  @@index([businessId])
  @@index([templateId])
}

// A message written by a person, filled in by code for each lead. Several for
// the same language, channel and gap are variants of one another, rotated so
// neighbouring businesses don't all get the same text. See src/lib/templates.ts.
model MessageTemplate {
  id        String   @id @default(cuid())
  language  String   // a DRAFT_LANGUAGES key, see src/lib/outreachOptions.ts
  channel   String   // email | phone | message
  gapKey    String   // the verified gap it is written for, e.g. "no_website"
  niche     String?  // only for this business type; null = any
  subject   String?  // email subject, or a title for a call script or message
  body      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  outreach  Outreach[]

  @@index([language, channel, gapKey])
}

model StageChange {
  id         String    @id @default(cuid())
  businessId String
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)

  fromStage  CrmStage
  toStage    CrmStage
  createdAt  DateTime  @default(now())

  @@index([businessId, createdAt])
}
