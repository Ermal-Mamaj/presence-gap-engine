DATABASE_URL="file:./dev.db"

# Drafts come from message templates (the Templates page). Set DRAFT_SOURCE=claude
# to have the Claude API write them instead, which needs a key from
# https://console.anthropic.com/
# DRAFT_SOURCE=claude
ANTHROPIC_API_KEY=

# Optional: override the Playwright Chromium binary path used by the
# Google Maps scraper source.
# PLAYWRIGHT_CHROMIUM_PATH=/opt/pw-browsers/chromium

# Optional: Overpass instances to query, in order, comma-separated. Defaults to
# overpass-api.de with overpass.private.coffee as fallback.
# OVERPASS_URLS=https://overpass-api.de/api/interpreter,https://overpass.private.coffee/api/interpreter

# Optional: send email drafts from the app (the Review & send page).
# There is no login yet: anyone who can reach the app could send from this
# mailbox, so start it with `npm run start:local`, which listens on this
# computer only. Use a mailbox on a separate outreach domain with SPF, DKIM
# and DMARC set up, from a provider whose terms allow cold outreach, and
# check the rules for unsolicited business email where you send.
# SMTP_URL=smtps://user:password@smtp.example.com:465
# MAIL_FROM="Your Name <you@outreach.example.com>"
# The line added to every email telling the reader how to opt out, in the
# language you write in. Required: nothing is sent without it.
# MAIL_OPT_OUT=
# MAIL_DAILY_LIMIT=20
# Build emails exactly as they would go out, without sending them:
# MAIL_DRY_RUN=1

# Optional: the online check, which searches the web for the own website of
# leads with none listed and verifies each page found against the lead's
# phone, name and street. Set one key or both: with both, Groq goes first and
# Tavily takes over whenever Groq hits its limit (and the other way round).
# GROQ_API_KEY=gsk_...      (browser_search on openai/gpt-oss-20b)
# TAVILY_API_KEY=tvly-...   (1 credit per lead; free plan 1,000 a month)
# ONLINE_CHECK_PROVIDER=tavily   (with both keys: try Tavily first)
