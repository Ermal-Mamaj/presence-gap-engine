DATABASE_URL="file:./dev.db"

# Required for outreach draft generation (stage 5). Get a key at
# https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional: draft with a free local model through Ollama instead of Claude.
# Needs `ollama serve` running and the model pulled (`ollama pull gemma3:4b`).
# Local models are weaker, especially in Albanian: read drafts before sending.
# DRAFT_PROVIDER=ollama
# OLLAMA_MODEL=llama3.2
# OLLAMA_URL=http://127.0.0.1:11434

# Optional: override the Playwright Chromium binary path used by the
# Google Maps scraper source.
# PLAYWRIGHT_CHROMIUM_PATH=/opt/pw-browsers/chromium
